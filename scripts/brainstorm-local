#!/usr/bin/env bash
set -e

cat <<'EOF'
Brainstorm OS local workflow examples

Setup:

  python3 -m venv .venv
  source .venv/bin/activate
  pip install -r scripts/requirements.txt
  export OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
  chmod +x scripts/brainstorm

Create a brainstorm:

  ./scripts/brainstorm "AI Discovery Process"

List generated files:

  find brainstorms -name "*.adoc"

Open the latest brainstorm:

  code "$(find brainstorms -name "BRAIN-*.adoc" | sort | tail -1)"

Optional Git workflow:

  git add brainstorms/
  git commit -m "Add brainstorm entry"

Planned command families:

  brainstorm create "topic"
  brainstorm prompt
  brainstorm concept "concept-name"
  brainstorm critique "claim"
  brainstorm synthesize "project-name"
  brainstorm proposal "topic"
  brainstorm argument-map "project-name"
  brainstorm book-outline "project-name"

This script prints examples only; it does not create files, open editors, or
commit changes.
EOF
